# Charte des figures des projets : thème Quiet Light, avec un violet tiré vers le bleu (indigo). Version claire.
# Ne pas charger à la main : passer par style/charte.py (charger_charte, sauver_clair_et_sombre).
# Ordre des séries, à garder fixe : indigo, orange, sarcelle.
# Validé le 2026-11-18 avec le validateur de la compétence dataviz (lisible pour les daltoniens, contraste >= 3:1 sur blanc).

font.family: IBM Plex Sans
font.size: 10
text.color: 333333

figure.facecolor: FFFFFF
figure.dpi: 110
savefig.facecolor: FFFFFF
savefig.dpi: 150
savefig.bbox: tight

axes.facecolor: FFFFFF
axes.edgecolor: D9D9E3
axes.linewidth: 0.8
axes.labelcolor: 6B6B7E
axes.labelsize: 10
axes.titlesize: 12
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 12
axes.titlecolor: 333333
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['4F4FC4', 'C0702A', '008B7E'])

grid.color: ECECF2
grid.linewidth: 0.6

xtick.color: D9D9E3
ytick.color: D9D9E3
xtick.labelcolor: 6B6B7E
ytick.labelcolor: 6B6B7E
xtick.labelsize: 9
ytick.labelsize: 9

lines.linewidth: 2
patch.edgecolor: FFFFFF

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: 333333
