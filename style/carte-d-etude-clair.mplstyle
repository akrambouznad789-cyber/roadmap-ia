# Charte « Carte d'étude » des figures, version claire (les README sur GitHub en thème clair).
# Ne pas charger à la main : passer par style/charte.py (charger_charte, sauver_clair_et_sombre).
# Ordre des séries, à garder fixe : saumon, menthe, bleu. Validé avec le validateur de la compétence dataviz
# (lisible pour les daltoniens, contraste >= 3:1 sur blanc).

font.family: Overpass
font.size: 10
text.color: 1F1F23

figure.facecolor: FFFFFF
figure.dpi: 110
savefig.facecolor: FFFFFF
savefig.dpi: 150
savefig.bbox: tight

axes.facecolor: FFFFFF
axes.edgecolor: D6D6DC
axes.linewidth: 0.8
axes.labelcolor: 5E5E68
axes.labelsize: 10
axes.titlesize: 12
axes.titleweight: medium
axes.titlelocation: left
axes.titlepad: 12
axes.titlecolor: 1F1F23
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['A23B33', '1B9C77', '3B6FC4'])

grid.color: EDEDF0
grid.linewidth: 0.6

xtick.color: D6D6DC
ytick.color: D6D6DC
xtick.labelcolor: 5E5E68
ytick.labelcolor: 5E5E68
xtick.labelsize: 9
ytick.labelsize: 9

lines.linewidth: 2
patch.edgecolor: FFFFFF

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: 1F1F23
