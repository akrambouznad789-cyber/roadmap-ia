# Charte « Route de nuit » des figures, version claire (les README sur GitHub en thème clair).
# Ne pas charger à la main : passer par style/charte.py (charger_charte, sauver_clair_et_sombre).
# Ordre des séries, à garder fixe : ambre, sarcelle, bleu. Validé avec le validateur de la compétence dataviz
# (lisible pour les daltoniens, contraste >= 3:1 sur blanc).

font.family: Hanken Grotesk
font.size: 10
text.color: 2A2F37

figure.facecolor: FFFFFF
figure.dpi: 110
savefig.facecolor: FFFFFF
savefig.dpi: 150
savefig.bbox: tight

axes.facecolor: FFFFFF
axes.edgecolor: D5D8DE
axes.linewidth: 0.8
axes.labelcolor: 5F6773
axes.labelsize: 10
axes.titlesize: 12
axes.titleweight: medium
axes.titlelocation: left
axes.titlepad: 12
axes.titlecolor: 2A2F37
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['A8700F', '00917F', '3A6FD8'])

grid.color: ECEEF1
grid.linewidth: 0.6

xtick.color: D5D8DE
ytick.color: D5D8DE
xtick.labelcolor: 5F6773
ytick.labelcolor: 5F6773
xtick.labelsize: 9
ytick.labelsize: 9

lines.linewidth: 2
patch.edgecolor: FFFFFF

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: 2A2F37
